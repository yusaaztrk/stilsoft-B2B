<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - B2B ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f6f7f9; }
        .app-shell { max-width: 1200px; }
        .kv { font-size: 12px; color: #6c757d; }
        .kvv { font-weight: 600; }
        .table thead th { white-space: nowrap; }
        .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
    <div class="container app-shell">
        <a class="navbar-brand fw-semibold" href="#">B2B ERP</a>
        <div class="ms-auto d-flex gap-2">
            @RenderSection("TopActions", required: false)
        </div>
    </div>
</nav>

<main class="container app-shell py-4">
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
