<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS barındırma ayarı — erp.example.com

  `dotnet publish` bu dosyayı alıp içine AspNetCoreModuleV2 işleyicisini ve doğru
  `processPath`/`arguments` değerlerini KENDİSİ ekler; burada yalnızca elle ayarlamak
  istediğimiz kısımlar duruyor.

  ASPNETCORE_ENVIRONMENT burada sabitlendi: sunucuda sistem geneli bir değişken
  tanımlamaya gerek kalmasın diye. Development olursa Swagger arayüzü herkese açılır ve
  CORS, localhost/192.168.* adreslerini serbest bırakan geliştirme dalına düşer.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <aspNetCore>
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Ürün görseli ve Excel içe aktarımı tek istekte büyük gövde gönderiyor.
        IIS'in varsayılanı 30 MB; değer yine de açıkça yazılıyor ki sunucu genelinde
        daha düşük bir sınır tanımlıysa bu site ondan etkilenmesin.
      -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- Sunucu sürümünü sızdırma. -->
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>

      <!--
        BANKA GERİ ÇAĞRISI POST İLE GELİR ve gövdesi form-urlencoded'dır.
        WebDAV modülü bazı Plesk kurulumlarında POST/PUT'u ele geçirip 405 döndürüyor;
        bu site için kaldırılıyor.
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
