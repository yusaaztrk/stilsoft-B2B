# Vitrinin ihtiyaç duyduğu ayarlar.
#
# Bu dosya ÖRNEKTİR ve git'te durur; gerçek değerler `.env.local` içine yazılır (git dışında).
# Yeni bir makinede kurulum yaparken bu dosyayı `.env.local` olarak kopyalayıp doldurun —
# eksik bırakıldığında kodun içindeki localhost varsayılanları devreye girer ve sorun
# geliştirmede fark edilmez, yalnızca yayında ortaya çıkar.

# Mağaza API'si — SUNUCU tarafında çağrılır, tarayıcıya sızmaz (NEXT_PUBLIC_ öneki YOK).
# API'nin internete açık olması gerekmiyor; sayfalar sunucuda render ediliyor.
SHOP_API_URL=http://localhost:5150

# Ürün görselleri mağaza API'sinin medya vekilinden geliyor (ERP internete açılmıyor).
# Tarayıcı bu adresi doğrudan çağırdığı için NEXT_PUBLIC_ olmak zorunda.
# Yayında: https://example.com/api/media  (ya da medya için ayrılan alt alan adı)
NEXT_PUBLIC_MEDIA_URL=http://localhost:5150/api/media

# Sitenin kendi adresi. Site haritası, canonical adresler ve yapısal veri bundan üretiliyor.
# YAYINDA MUTLAKA GERÇEK ADRES OLMALI: localhost kalırsa Google'a gönderilen site haritasındaki
# bütün adresler localhost gösterir ve hiçbir sayfa dizine girmez.
# Yayında: https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
