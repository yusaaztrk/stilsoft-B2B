<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS barındırma ayarı — servis.example.com

  `dotnet publish` handler'ı kendisi ekler; burada yalnızca elle ayarladığımız kısımlar var.
  ASPNETCORE_ENVIRONMENT sabitlendi: Development olursa CORS geliştirme dalına düşüp
  her kaynağı serbest bırakır.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <aspNetCore>
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!-- Servis fişi fotoğrafları ve arıza görselleri tek istekte gelebiliyor. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>

      <!--
        X-Frame-Options BİLEREK YOK: saha uygulaması ServiceOps arayüzünü WebView içinde
        açıyor. SAMEORIGIN eklenirse mobil uygulama boş ekran gösterir.
        Bkz. [serviceops_webview_uygulamasi] notu.
      -->

      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
