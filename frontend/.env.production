# ÜRETİM DERLEMESİ AYARLARI (vite build)
#
# VITE_API_BASE_URL BİLEREK YOK: ERP API'si panelle AYNI kaynakta duruyor ve
# `src/config/api.ts` adresi çalışma anında `window.location.origin`den çözüyor.
# Buraya bir adres yazmak, paneli tek bir alan adına çivilerdi.
#
# VITE_SHOP_API_BASE_URL ise ZORUNLU: mağaza API'si AYRI bir alan adında
# (example.com/shopapi). Verilmezse `EticaretPage.tsx` yedeğe düşüp
# `https://<panelin alan adı>:5150` adresini çağırıyor; o port dışarı kapalı
# olduğu için E-Ticaret ekranlarının tamamı ERR_CONNECTION_TIMED_OUT veriyor.
# (2026-09-08'de canlıda tam olarak bu oldu.)
VITE_SHOP_API_BASE_URL=https://example.com/shopapi

# Vitrinin adresi. Panelden "Vitrinde gor" ile urun sayfasi acilirken kullaniliyor.
VITE_SHOP_SITE_URL=https://example.com
