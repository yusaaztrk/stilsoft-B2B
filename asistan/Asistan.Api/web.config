<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS barındırma ayarı — asistan.example.com (2026-10-08)

  `dotnet publish` handler'ı (aspNetCore modülü, inprocess) kendisi ekler; burada yalnız elle
  ayarladığımız kısımlar var.
  - ASPNETCORE_ENVIRONMENT sabit: Development olursa sahte WhatsApp ve sahte yapay zekâ devreye girer,
    /dev/whatsapp/* deneme uçları açılır.
  - stdout günlüğü açık: açılışta çöken uygulamanın nedeni logs\stdout_*.log'da görünsün
    (Plesk'te 500.30 sayfası sebep söylemiyor). Klasör pakette boş olarak geliyor.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <aspNetCore stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
