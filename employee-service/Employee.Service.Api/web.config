<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS barindirma ayari.

  `dotnet publish` bu dosyayi alip icine AspNetCoreModuleV2 isleyicisini ve dogru
  `processPath`/`arguments` degerlerini KENDISI ekler; burada yalnizca elle ayarlamak
  istedigimiz kisimlar duruyor.

  Ortam degiskeni burada sabitlendi: sunucuda sistem geneli bir ASPNETCORE_ENVIRONMENT
  tanimlamaya gerek kalmasin diye. Bu deger Development olursa Swagger arayuzu herkese
  acilir ve CORS, localhost/192.168.* adreslerini serbest birakan gelistirme dalina duser.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <aspNetCore>
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Yuz kaydi tek istekte 5 adet base64 JPEG gonderiyor. IIS'in varsayilan 30 MB siniri
        bunun icin yeterli; deger yine de acikca yaziliyor ki sunucu genelinde daha dusuk bir
        sinir tanimliysa bu site ondan etkilenmesin.
      -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
